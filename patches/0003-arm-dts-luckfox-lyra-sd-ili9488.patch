+/*
+ * ILI9488 on the 2048 base header.
+ * Pin 24 GPIO1_D1 RMIO29 SPI0_CLK, pin 25 GPIO1_C3 RMIO28 SPI0_MOSI,
+ * pin 22 GPIO1_D2 RMIO30 SPI0_CSN0, pin 26 GPIO1_C2 DC,
+ * pin 20 GPIO0_A2 reset, pin 21 GPIO1_D3 backlight.
+ *
+ * RMIO function number is the TRM index plus 15, because these banks use a
+ * 4-bit iomux and rockchip_set_rmio() stores (mux - 15). The existing I2C2
+ * nodes use the same offset: I2C2_SCL 19 -> 34. SPI0_CLK 67 -> 82,
+ * SPI0_MOSI 68 -> 83, SPI0_CSN0 70 -> 85.
+ *
+ * hsync/vsync lengths stay 0. panel-mipi-dbi rejects a timing whose
+ * hsync_end is past hdisplay. Landscape is MADCTL 0x28, so rotation stays 0.
+ * format b6x2g6x2r6x2 matches 8bpw RGB888 plus the BGR bit in 0x28.
+ */
+&pinctrl {
+	ili9488 {
+		ili9488_pins: ili9488-pins {
+			rockchip,pins =
+				<1 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>,
+				<0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>,
+				<1 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	rm_io29 {
+		rm_io29_spi0_clk: rm-io29-spi0-clk {
+			rockchip,pins =
+				<1 RK_PD1 82 &pcfg_pull_none_drv_level_3>;
+		};
+	};
+
+	rm_io28 {
+		rm_io28_spi0_mosi: rm-io28-spi0-mosi {
+			rockchip,pins =
+				<1 RK_PC3 83 &pcfg_pull_none_drv_level_3>;
+		};
+	};
+
+	rm_io30 {
+		rm_io30_spi0_csn0: rm-io30-spi0-csn0 {
+			rockchip,pins =
+				<1 RK_PD2 85 &pcfg_pull_none_drv_level_3>;
+		};
+	};
+};
+
+&spi0 {
+	status = "okay";
+	num-cs = <1>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&rm_io29_spi0_clk &rm_io28_spi0_mosi &rm_io30_spi0_csn0>;
+
+	ili9488@0 {
+		compatible = "ili9488", "panel-mipi-dbi-spi";
+		reg = <0>;
+		spi-max-frequency = <20000000>;
+		write-only;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ili9488_pins>;
+
+		dc-gpios = <&gpio1 RK_PC2 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
+		backlight = <&ili9488_backlight>;
+		power-supply = <&vcc_3v3>;
+
+		width-mm = <73>;
+		height-mm = <49>;
+		rotation = <0>;
+		format = "b6x2g6x2r6x2";
+
+		panel-timing {
+			hactive = <480>;
+			vactive = <320>;
+			hback-porch = <0>;
+			hfront-porch = <0>;
+			hsync-len = <0>;
+			vback-porch = <0>;
+			vfront-porch = <0>;
+			vsync-len = <0>;
+			clock-frequency = <0>;
+		};
+	};
+};
